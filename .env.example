# Токен бота від @BotFather
BOT_TOKEN=

# Твій особистий Telegram user_id (число). Дізнатись можна, написавши /start боту @userinfobot
ADMIN_TELEGRAM_ID=

# Чи надсилати адміну сповіщення про нові кандидати в FAQ (true/false)
NOTIFY_ADMIN_ON_NEW_CANDIDATES=true

# Cron-розклад для щоденного аналізу (за замовчуванням 23:50 щодня)
DAILY_ANALYSIS_CRON=50 23 * * *

# Автовідповідач (якщо true, бот буде автоматично відповідати на стандартні питання, якщо false — адміністратор повинен вручну підтверджувати відповіді)
AUTO_REPLY_FIXED_ENABLED=true
AUTO_REPLY_LLM_ENABLED=true